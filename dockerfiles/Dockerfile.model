# GH200-friendly CUDA+PyTorch base (multi-arch; has arm64 variant)
FROM nvcr.io/nvidia/pytorch:24.08-py3

# Your app setup
WORKDIR /app
COPY pyproject.toml requirements.txt* /app/
RUN pip install --upgrade pip && \
    if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
COPY . /app

# If you run uv, install it here (arm64 binary is fine) or just stick with pip.
# Expose + entrypoint as needed
CMD ["python", "-m", "your_model_package.server"]
